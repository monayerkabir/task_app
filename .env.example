# Copy to .env.local for local development. On Vercel, add these under
# Project > Settings > Environment Variables.

# Supabase > Project Settings > API (or "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# the "anon" / "publishable" key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# the "service_role" / "secret" key. Server only. Never share it.
SUPABASE_SERVICE_ROLE_KEY=

# Your app's address, used in email links (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://tick-analytics.vercel.app

# Any long random string. Vercel Cron sends it so only Vercel can run the daily job.
CRON_SECRET=

# Email (optional but recommended). Gmail: smtp.gmail.com, port 465, your Gmail
# address and a 16-letter App Password (Google Account > Security > App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Tick Analytics <you@gmail.com>"

# Phone push alerts. Generate once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional: a different holiday feed (iCal). Defaults to Google's public
# "Holidays in Bangladesh" calendar.
# HOLIDAY_ICS_URL=
